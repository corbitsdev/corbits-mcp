{
  "name": "@corbits/mcp",
  "version": "0.3.1",
  "description": "MCP client tool package for Interchange: streamable HTTP, per-tool grants, OAuth.",
  "keywords": [
    "corbits",
    "interchange",
    "mcp",
    "model-context-protocol",
    "tools"
  ],
  "homepage": "https://github.com/corbitsdev/corbits-mcp#readme",
  "bugs": {
    "url": "https://github.com/corbitsdev/corbits-mcp/issues"
  },
  "license": "LGPL-2.1-only",
  "author": "Sawyer Cutler <sawyer@dirtroad.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/corbitsdev/corbits-mcp.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs",
    "examples"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sidecar-bundle": {
      "types": "./dist/sidecar-bundle.d.ts",
      "default": "./dist/sidecar-bundle.js"
    },
    "./hub": {
      "types": "./dist/hub/index.d.ts",
      "default": "./dist/hub/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./interchange/client": {
      "types": "./dist/interchange/client.d.ts",
      "default": "./dist/interchange/client.js"
    },
    "./interchange/server": {
      "types": "./dist/interchange/server.d.ts",
      "default": "./dist/interchange/server.js"
    },
    "./server/task-store": {
      "types": "./dist/extensions/tasks/file-store.d.ts",
      "default": "./dist/extensions/tasks/file-store.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "bun test src --pass-with-no-tests",
    "test:e2e": "bun test e2e",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test",
    "test:package": "bun test e2e/package.test.ts"
  },
  "dependencies": {
    "@intx/types": "^0.5.0",
    "ajv": "^8.17.1",
    "arktype": "^2.2.3",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@corbits/credential-http": "0.1.0",
    "@corbits/oauth-core": "0.3.0",
    "@intx/agent": "0.5.0",
    "@intx/authz": "0.5.0",
    "@intx/db": "0.5.0",
    "@intx/harness": "0.5.0",
    "@intx/hub-api": "0.5.0",
    "@modelcontextprotocol/sdk": "1.30.1",
    "@types/bun": "1.3.9",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.9",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "typescript": "5.9.3",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "@corbits/credential-http": "^0.1.0",
    "@corbits/oauth-core": "^0.3.0",
    "@intx/agent": "^0.5.0",
    "@intx/db": "^0.5.0",
    "@intx/harness": "^0.4.0 || ^0.5.0",
    "@intx/hub-api": "^0.5.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.11.9"
  },
  "peerDependenciesMeta": {
    "@corbits/credential-http": {
      "optional": true
    },
    "@intx/db": {
      "optional": true
    },
    "@intx/hub-api": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    },
    "hono": {
      "optional": true
    },
    "@intx/agent": {
      "optional": true
    },
    "@intx/harness": {
      "optional": true
    },
    "@corbits/oauth-core": {
      "optional": true
    }
  },
  "engines": {
    "bun": ">=1.2.0",
    "node": ">=24"
  },
  "interchange": {
    "credentials": [
      {
        "handle": "mcp-server",
        "scopes": []
      }
    ]
  }
}
