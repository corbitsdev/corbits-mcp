{
  "name": "@corbits/mcp",
  "version": "0.1.0",
  "description": "MCP client tool package for Interchange: streamable HTTP, per-tool grants, OAuth.",
  "license": "LGPL-2.1-only",
  "author": "Sawyer Cutler <sawyer@dirtroad.dev>",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sidecar-bundle": {
      "types": "./dist/sidecar-bundle.d.ts",
      "default": "./dist/sidecar-bundle.js"
    },
    "./hub": {
      "types": "./dist/hub/index.d.ts",
      "default": "./dist/hub/index.js"
    }
  },
  "interchange": {
    "credentials": [
      {
        "handle": "mcp-server",
        "scopes": []
      }
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test"
  },
  "peerDependencies": {
    "@corbits/credential-mcp": "^0.1.0",
    "@intx/agent": "^0.4.0",
    "@intx/db": "^0.4.0",
    "@intx/harness": "^0.4.0",
    "@intx/hub-api": "^0.4.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.11.9"
  },
  "peerDependenciesMeta": {
    "@intx/db": {
      "optional": true
    },
    "@intx/hub-api": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    },
    "hono": {
      "optional": true
    }
  },
  "dependencies": {
    "@corbits/oauth-core": "^0.1.0",
    "@intx/types": "^0.4.0",
    "arktype": "^2.2.3"
  },
  "devDependencies": {
    "@corbits/credential-mcp": "^0.1.0",
    "@eslint/js": "9.34.0",
    "@intx/agent": "0.4.0",
    "@intx/authz": "0.4.0",
    "@intx/db": "0.4.0",
    "@intx/harness": "0.4.0",
    "@intx/hub-api": "0.4.0",
    "@intx/types": "0.4.0",
    "@types/bun": "1.3.9",
    "drizzle-orm": "0.45.3",
    "eslint": "9.34.0",
    "hono": "4.13.9",
    "jiti": "2.5.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.42.0"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/corbitsdev/corbits-mcp.git"
  },
  "homepage": "https://github.com/corbitsdev/corbits-mcp",
  "bugs": {
    "url": "https://github.com/corbitsdev/corbits-mcp/issues"
  }
}
