{
  "name": "@corbits/mcp",
  "version": "0.1.0",
  "description": "MCP client tool package for Interchange: streamable HTTP, per-tool grants, OAuth.",
  "license": "LGPL-2.1-only",
  "author": "Sawyer Cutler <sawyer@dirtroad.dev>",
  "type": "module",
  "sideEffects": false,
  "files": [
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./src/index.ts",
    "./sidecar-bundle": "./src/sidecar-bundle.ts",
    "./hub": "./src/hub/index.ts"
  },
  "interchange": {
    "credentials": [
      {
        "handle": "mcp-server",
        "scopes": []
      }
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test"
  },
  "peerDependencies": {
    "@intx/agent": ">=0.3.0"
  },
  "dependencies": {
    "@corbits/credential-mcp": "github:corbitsdev/corbits-credential-mcp#fb9ec3a6754348cd33c388c70c0830b8844c83de",
    "@intx/db": "^0.3.0",
    "@intx/hub-api": "^0.3.0",
    "@intx/types": "^0.3.0",
    "arktype": "2.1.20",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.11.9"
  },
  "devDependencies": {
    "@eslint/js": "9.34.0",
    "@intx/agent": "0.3.0",
    "@intx/authz": "0.3.0",
    "@intx/harness": "0.3.0",
    "@intx/types": "0.3.0",
    "@types/bun": "1.3.9",
    "eslint": "9.34.0",
    "jiti": "2.5.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.42.0"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/corbitsdev/corbits-mcp.git"
  },
  "homepage": "https://github.com/corbitsdev/corbits-mcp",
  "bugs": {
    "url": "https://github.com/corbitsdev/corbits-mcp/issues"
  }
}
